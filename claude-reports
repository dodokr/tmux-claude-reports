    all.textContent = open ? 'Collapse all' : 'Expand all';
  };
  sec.append(h, ol);
  const hidden = META.turn - 1 - TURNS.length;
  if (hidden > 0) sec.append(el('p', 'hidden-turns', hidden + ' older turn' + (hidden > 1 ? 's' : '') + ' not shown'));
  document.getElementById('earlier').append(sec);
}
