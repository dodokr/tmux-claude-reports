def count(fmt_tmux):
    n = sum(1 for m in reports() if m.get("unread"))
    if not fmt_tmux:
        print(n)
    elif n:
        print(f"#[fg=#a6e3a1]● {n} report{'s' if n > 1 else ''}#[default] ")


def toggle(sid):
    meta = load(sid)
    set_unread(meta, not meta.get("unread"))
    refresh_status()


HELP_LABEL = " keys "  # header label while the full key list shows; there is no border, so unseen


def help_text():
    """(short header, full key list). One source for the picker and `keys-toggle`."""
    short = "Enter open · c go to session · dd delete · ? more"
    rows = [("j / k", "move"), ("g / G", "top / bottom"), ("Enter", "open in the browser"),
            ("c", "go to the session (pane, or resume)"), ("m", "mark read / unread"),
            ("dd", "delete the report"), ("a", "mark all read"), ("C-d / C-u", "scroll the preview"),
            ("/", "filter (Esc leaves it)"), ("r", "refresh")]
    if shutil.which("claude-tasks"):
        rows.append(("t", "claude-tasks"))
    rows += [("?", "close this help"), ("q / Esc", "quit")]
    return short, "\n".join(f"{k:<10} {v}" for k, v in rows)


def keys_toggle():
    """fzf action for "?": swap the short header and the full key list. The header label
    carries the state, because fzf doesn't expose the header text itself."""
    short, full = help_text()
    if os.environ.get("FZF_HEADER_LABEL") == HELP_LABEL:
        print(f"change-header-label()+change-header:{short}")
    else:
        print(f"change-header-label({HELP_LABEL})+change-header:{full}")


def ui():
    if not shutil.which("fzf"):
        sys.exit("claude-reports: needs fzf")
    me = shlex.quote(SELF)
    keys = "j,k,g,G,d,c,m,a,r,q,/,?"
    header = help_text()[0]
    extra = []
    if shutil.which("claude-tasks"):
        keys += ",t"
        extra.append("--bind=t:become(claude-tasks)")
    preview = f"{me} show {{1}}"
    if shutil.which("bat"):
        preview += (" | bat -l md --style=plain --color=always --paging=never"
                    " --terminal-width=$FZF_PREVIEW_COLUMNS")
    reset = "change-prompt(> )"
    normal = f"rebind({keys})+hide-input+clear-query+{reset}"
    dd = (f"[[ $FZF_PROMPT == 'd> ' ]] && echo '{reset}+execute-silent({me} delete {{1}})"
          f"+reload({me} list)' || echo 'change-prompt(d> )'")
    listing = subprocess.run([SELF, "list"], capture_output=True, text=True).stdout
    if not listing:
        listing = "-\t\x1b[90m(no reports yet: one appears each time Claude finishes a reply)\x1b[0m\n"
    subprocess.run([
        "fzf", "--ansi", "--no-sort", "--no-input", "--delimiter=\t", "--with-nth=2",
        "--layout=reverse", "--border=rounded", "--border-label= Claude reports ",
        f"--header={header}", "--header-first", "--info=hidden", "--pointer=▌",
        "--gutter= ", "--prompt=> ", "--with-shell=bash -c",
        f"--preview={preview}", "--preview-window=right,50%,wrap,<70(down,60%,wrap)",
        f"--bind=j:down+{reset},k:up+{reset},g:first+{reset},G:last+{reset},q:abort",
        "--bind=ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up",
        f"--bind=enter:execute-silent({me} open {{1}})+abort",
        f"--bind=c:execute-silent({me} resume {{1}})+abort",
        f"--bind=m:execute-silent({me} toggle {{1}})+reload({me} list)+{reset}",
        f"--bind=d:transform:{dd}",
        f"--bind=a:execute-silent({me} read-all)+reload({me} list)+{reset}",
        f"--bind=r:reload({me} list)+{reset}",
        f"--bind=?:transform:{me} keys-toggle",
        f"--bind=/:show-input+unbind({keys})+{reset}",
        f"--bind=esc:transform:[[ $FZF_INPUT_STATE == hidden ]] && echo abort || echo '{normal}'",
        *extra,
    ], input=listing, text=True)


def main(argv):
    cmd, args = (argv[0] if argv else ""), argv[1:]
    if cmd == "hook":
        try:
            hook()
        except Exception as e:  # never break Claude; leave a trace instead
            with open(STATE / "errors.log", "a") as f:
                f.write(f"{datetime.now().isoformat()} {type(e).__name__}: {e}\n")
    elif cmd == "list":
        list_reports()
    elif cmd in ("show", "open", "resume", "delete", "toggle") and len(args) == 1:
        sid = args[0]
        if sid == "-":
            return
        {"show": show, "open": open_report, "resume": resume, "toggle": toggle,
         "delete": lambda i: (load(i), remove(i), refresh_status())}[cmd](sid)
    elif cmd == "read-all":
        for m in reports():
            set_unread(m, False)
        refresh_status()
    elif cmd == "count":
        count("--tmux" in args)
    elif cmd == "open-pane" and len(args) == 1:
        open_pane(args[0])
    elif cmd == "keys-toggle":
        keys_toggle()
    elif cmd == "serve":
        serve()
    elif cmd == "":
        ui()
    else:
        sys.exit(__doc__.split("\n\n")[1])


if __name__ == "__main__":
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    main(sys.argv[1:])
