    path.append(el('span', 'dir', f.slice(0, cut)), f.slice(cut));
    row.append(icon('file'), path);
    list.append(row);
  }
  sec.append(h, list);
  document.getElementById('files').append(sec);
}

if (TURNS.length) {
  const sec = el('section', 'section');
  const h = el('div', 'section-head');
  const all = el('button', 'ghost', 'Expand all');
  h.append(el('h2', '', 'Earlier in this session'), String(TURNS.length), el('span', 'grow'), all);
  const ol = el('ol', 'timeline');
  for (const t of TURNS) {
    const li = el('li', 'turn');
    const d = el('details');
    const s = el('summary');
    const w = who(t.prompt.split('\n\n↳ ')[0]);
    const q = el('span', 'q');
    if (w.peer) q.append(el('span', 'who', w.name + ': '));
    q.append(oneLine(w.text));
    s.append(q, el('span', 'r', t.reply ? oneLine(t.reply.replace(/```[\s\S]*?```/g, ' ').replace(/^[ \t]*(?:#+|>|[-*+]|\d+\.)[ \t]+/gm, '').replace(/\*\*|`/g, '')).slice(0, 240) : '(no reply)'));
    const body = el('div', 'turn-body');
    d.append(s, body);
    // Rendered on first open: 20 turns of markdown are cheap, but there's no need up front.
    d.addEventListener('toggle', () => {
