  thread.append(markdown(SRC.replace(/^# .*\n+(?:>.*\n+)*(?:\|.*\n)+\n*/, '')));
}

if (PAGE && META.files.length) {
  const sec = el('section', 'section');
  const h = el('div', 'section-head');
  h.append(el('h2', '', 'Files changed'), String(META.files.length));
  const list = el('div', 'files');
  for (const f of META.files) {
