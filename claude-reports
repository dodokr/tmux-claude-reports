BAR_JS = r"""
const ID = %s, TOKEN = %s, VERSION = %s;
const $ = (id) => document.getElementById(id);
let state = null, toastTimer = null;
function toast(text) {
  $('status').textContent = text;
  $('status').classList.add('on');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => $('status').classList.remove('on'), 5000);
}
function show(s, note) {
  state = s;
  $('newer').classList.toggle('on', s.version > VERSION);
  $('focus').lastChild.textContent = s.open ? 'Go to pane' : 'Resume session';
  $('focus').title = s.open ? 'Show the pane in tmux and raise its Konsole window'
                            : 'The session is closed: resume it in a new tmux window';
  $('read').lastChild.textContent = s.unread ? 'Mark read' : 'Mark unread';
  $('kill').disabled = !s.open;
  if (window.setLive) setLive(s);
  if (note) toast(note);
}
async function call(method, path) {
  try {
    const r = await fetch(path, { method, headers: { 'X-Claude-Reports': TOKEN } });
    const body = await r.json();
    if (body.state) show(body.state, r.ok ? body.message : 'Error: ' + body.message);
    else toast(r.status === 404 ? 'This report was deleted' : 'Error: ' + (body.message || r.status));
    return body.state;
  } catch (e) {
    toast('claude-reports server is not running (reopen from the popup)');
  }
}
const refresh = () => call('GET', '/api/state/' + ID);
$('newer').onclick = () => location.reload();
$('focus').onclick = () => call('POST', '/api/focus/' + ID);
$('read').onclick = () => call('POST', '/api/' + (state && !state.unread ? 'unread' : 'read') + '/' + ID);
$('kill').onclick = () => {
  if (confirm('Kill this Claude session and close its tmux pane (' + state.target + ')?\n\nThe report stays.'))
    call('POST', '/api/kill/' + ID);
};
// Check for a newer reply when you come back to the tab, and every 5 s while it's visible.
window.addEventListener('focus', refresh);
setInterval(() => { if (document.visibilityState === 'visible') refresh(); }, 5000);
// Opening a report means reading it; "Mark unread" undoes that.
refresh().then((s) => { if (s && s.unread) call('POST', '/api/read/' + ID); });
"""

# Without markdown-it (the python-markdown or plain-text fallback): the old simple page.
FALLBACK_CSS = """
body { margin: 0; background: var(--bg); color: var(--fg); }
.markdown-body { box-sizing: border-box; max-width: 860px; margin: 0 auto; padding: 32px 24px 64px; }
"""


def page_title(meta):
    # Unique, so a window manager script can find the browser window showing it.
    return f"{meta.get('title', 'Report')} · claude-report {meta['id'][:8]}"


def view_of(meta):
    """The metadata the page shows, ready to display."""
    start, end = local(meta.get("started")), datetime.fromtimestamp(meta.get("ended", 0)).astimezone()
    return {"id": meta["id"], "title": meta.get("title", "Report"), "tmux": meta.get("tmux", ""),
            "folder": home(meta.get("cwd") or ""), "branch": meta.get("branch", ""),
            "ended": meta.get("ended", 0), "turn": meta.get("prompts", 0),
            "session": duration(start, end) if start else "", "files": meta.get("files") or [],
            "unfinished": bool(meta.get("unfinished")), "background": meta.get("background", 0)}


def page_files(sid):
    """(earlier turns, page data) the hook saved next to the markdown; None for older reports."""
    out = []
    for name in (f"{sid}.turns.json", f"{sid}.page.json"):
        try:
            out.append(json.loads((STATE / name).read_text(encoding="utf-8")))
        except (OSError, ValueError):
            out.append(None)
    return out


def render(meta, md, token=None, nonce=None, turns=None, page=None):
    """A report page. With a token it is served by `claude-reports serve`: assets come from
    /assets/ and the page gets the buttons. Without, it is a standalone file:// page.

    markdown-it (from live-preview.nvim) when its files are there: the page script lays out
    the prompt, reply, files and earlier turns from the JSON it is given. Else python-markdown;
    else preformatted text."""
    served = token is not None

    def asset(rel):
        return f"/assets/{rel}" if served else (ASSETS / rel).as_uri()

    def blob(id_, value):
        return (f'<script type="application/json" id="{id_}">'
                f'{json.dumps(value, ensure_ascii=False).replace("</", "<" + chr(92) + "/")}</script>')

    n = f' nonce="{nonce}"' if nonce else ""
    head = (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width,initial-scale=1">'
            f'<title>{html.escape(page_title(meta))}</title>')
    if (ASSETS / "markdown/github-markdown.min.css").is_file():
        head += f'<link rel="stylesheet" href="{asset("markdown/github-markdown.min.css")}">'
    if (ASSETS / "markdown/markdown-it.min.js").is_file():
        head += f"<style{n}>{PAGE_CSS}</style>"
        if (ASSETS / "highlight/highlight.min.js").is_file():
            head += (f'<link rel="stylesheet" href="{asset("highlight/main.css")}">'
                     f'<script src="{asset("highlight/highlight.min.js")}"></script>')
        if turns is not None and f"\n{EARLIER}\n" in md:
            md = md.split(f"\n{EARLIER}\n", 1)[0]  # shown from the turns instead
        body = top_html(served, meta.get("title", "Report")) + MAIN_HTML
        body += (blob("src", md) + blob("turns", turns or []) + blob("meta", view_of(meta))
                 + blob("page", page) + blob("icons", ICONS) + blob("avatars", avatars())
                 + f'<script src="{asset("markdown/markdown-it.min.js")}"></script>'
                 f'<script{n}>{RENDER_JS}</script>')
    else:
        head += f"<style{n}>{PAGE_CSS.split('/* top bar */')[0]}{FALLBACK_CSS}</style>"
        try:
            import markdown
            conv = markdown.Markdown(extensions=["extra", "sane_lists"])
            # Reports contain arbitrary transcript text: show raw HTML as text, don't run it.
            conv.preprocessors.deregister("html_block")
            conv.inlinePatterns.deregister("html")
            inner = conv.convert(md)
        except ImportError:
            inner = f"<pre>{html.escape(md)}</pre>"
        body = (top_html(served, meta.get("title", "Report")) if served else "")
        body += f'<article class="markdown-body">{inner}</article>'
    if served:
        js = BAR_JS % (json.dumps(meta["id"]), json.dumps(token), json.dumps(meta.get("ended", 0)))
        body += f"<script{n}>{js.replace('</', '<' + chr(92) + '/')}</script>"
    return f"{head}</head><body>{body}</body></html>\n"


# ---------------------------------------------------------------- server
# Serves the report pages and runs the buttons, on 127.0.0.1 only. See README "Safety".

def token():
    """The server's secret: random, made once, readable only by you (mode 600)."""
    path = STATE / "token"
    try:
        t = path.read_text().strip()
    except OSError:
        t = ""
    if len(t) < 64:
        t = secrets.token_hex(32)
        tmp = path.with_name("token.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(t + "\n")
        tmp.replace(path)
    return t


ASSET_TYPES = {".js": "text/javascript", ".css": "text/css", ".woff2": "font/woff2",
               ".woff": "font/woff", ".ttf": "font/ttf", ".svg": "image/svg+xml"}


def make_handler(port, secret, touch):
    from http.server import BaseHTTPRequestHandler

    origins = {f"127.0.0.1:{port}", f"localhost:{port}"}

    class Handler(BaseHTTPRequestHandler):
        server_version = "claude-reports"
        sys_version = ""

        def log_message(self, *args):
            pass

        def send(self, status, body, ctype="application/json", headers=()):
            data = body if isinstance(body, bytes) else body.encode()
            self.send_response(status)
            self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith(("text/", "application/json")) else ""))
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Referrer-Policy", "no-referrer")
            for k, v in headers:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def reply(self, status, message, sid=None):
            body = {"message": message}
            if sid and (meta := find(sid)):
                body["state"] = state_of(meta)
            self.send(status, json.dumps(body))

        def host_ok(self):
            # Blocks DNS rebinding: a hostile site whose name resolves to 127.0.0.1 still
            # sends its own name as Host, so it can't read anything from here.
            return self.headers.get("Host") in origins

        def cookie_ok(self):
            for part in (self.headers.get("Cookie") or "").split(";"):
                k, _, v = part.strip().partition("=")
                if k == "claude_reports" and hmac.compare_digest(v.encode(), secret.encode()):
                    return True
            return False

        def do_GET(self):
            touch()
            if not self.host_ok():
                return self.send(403, "forbidden", "text/plain")
            url = urlsplit(self.path)
            if url.path == "/ping":
                return self.send(200, "claude-reports", "text/plain")
            if url.path.startswith("/assets/"):
                return self.asset(unquote(url.path[len("/assets/"):]))
            if m := re.fullmatch(r"/r/([A-Za-z0-9-]+)", url.path):
                sid = m.group(1)
                t = parse_qs(url.query).get("t", [""])[0]
                if t and hmac.compare_digest(t.encode(), secret.encode()):
                    # Trade the token in the URL for a cookie, then drop it from the address bar.
                    return self.send(303, "", "text/plain", [
                        ("Location", f"/r/{sid}"),
                        ("Set-Cookie", f"claude_reports={secret}; Path=/; HttpOnly; SameSite=Strict; Max-Age=31536000")])
                if not self.cookie_ok():
                    return self.send(403, "Open this report from the claude-reports popup.", "text/plain")
                meta = find(sid)
                if meta is None:
                    return self.send(404, "No such report (deleted or pruned).", "text/plain")
                md = (STATE / f"{sid}.md").read_text(encoding="utf-8")
                nonce = secrets.token_urlsafe(16)
                csp = (f"default-src 'none'; script-src 'self' 'nonce-{nonce}'; "
                       f"style-src 'self' 'nonce-{nonce}'; font-src 'self'; img-src 'self' data:; "
                       "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
                turns, page = page_files(sid)  # None for older reports: the markdown has it all
                return self.send(200, render(meta, md, secret, nonce, turns, page), "text/html",
                                 [("Content-Security-Policy", csp)])
            if m := re.fullmatch(r"/api/state/([A-Za-z0-9-]+)", url.path):
                if not (self.cookie_ok() and self.header_token_ok()):
                    return self.reply(403, "forbidden")
                return self.reply(200, "", m.group(1)) if find(m.group(1)) else self.reply(404, "no such report")
            self.send(404, "not found", "text/plain")

        def header_token_ok(self):
            # A custom header: browsers only let a page send one cross-origin after a CORS
            # preflight, which this server never approves.
            return hmac.compare_digest((self.headers.get("X-Claude-Reports") or "").encode(), secret.encode())

        def do_POST(self):
            touch()
            origin = self.headers.get("Origin")
            if not (self.host_ok() and origin in {f"http://{o}" for o in origins}
                    and self.cookie_ok() and self.header_token_ok()):
                return self.reply(403, "forbidden")
            m = re.fullmatch(r"/api/(read|unread|focus|kill)/([A-Za-z0-9-]+)", urlsplit(self.path).path)
            if not m:
                return self.reply(404, "not found")
            status, msg = act(m.group(1), m.group(2))
            self.reply(status, msg, m.group(2))

        def asset(self, rel):
            root = ASSETS.resolve()
            path = (root / rel).resolve()
            if not path.is_relative_to(root) or path.suffix not in ASSET_TYPES or not path.is_file():
                return self.send(404, "not found", "text/plain")
            self.send(200, path.read_bytes(), ASSET_TYPES[path.suffix])

    return Handler


def serve():
    """HTTP server on 127.0.0.1. Uses a listening socket from systemd (socket activation)
    when given one; exits after $CLAUDE_REPORTS_IDLE seconds without requests."""
    import socket
    import threading
    from http.server import ThreadingHTTPServer

    secret = token()
    last = [time.monotonic()]
    activated = os.environ.get("LISTEN_FDS") == "1" and os.environ.get("LISTEN_PID") == str(os.getpid())
    if activated:
        sock = socket.socket(fileno=3)
        port = sock.getsockname()[1]
        httpd = ThreadingHTTPServer(("127.0.0.1", port), None, bind_and_activate=False)
        httpd.socket.close()
        httpd.socket = sock
    else:
        httpd = ThreadingHTTPServer(("127.0.0.1", PORT), None)
        port = httpd.server_address[1]
    httpd.RequestHandlerClass = make_handler(port, secret, lambda: last.__setitem__(0, time.monotonic()))
    httpd.daemon_threads = True

    def idle():
        while time.monotonic() - last[0] < IDLE:
            time.sleep(min(30, IDLE))
        httpd.shutdown()

    threading.Thread(target=idle, daemon=True).start()
    httpd.serve_forever()


def server_up():
    import urllib.request
    try:
        req = urllib.request.Request(f"http://127.0.0.1:{PORT}/ping")
        with urllib.request.urlopen(req, timeout=1) as r:
            return r.read() == b"claude-reports"
    except OSError:
        return False


def ensure_server():
    """True when the server answers; starts one (it exits when idle) if nothing does."""
    if server_up():
        return True
    proc = subprocess.Popen([SELF, "serve"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(30):
        time.sleep(0.1)
        if server_up():
            return True
        if proc.poll() is not None:
            return False  # it couldn't start, e.g. something else holds the port
    return False


def open_report(sid):
    meta = load(sid)
    if ensure_server():
        url = f"http://127.0.0.1:{PORT}/r/{sid}?t={token()}"
    else:  # no server: a static page, without buttons
        page = STATE / "html" / f"{sid}.html"
        page.parent.mkdir(parents=True, exist_ok=True)
        md = (STATE / f"{sid}.md").read_text(encoding="utf-8")
        write_atomic(page, render(meta, md, None, None, *page_files(sid)))
        url = page.as_uri()
        set_unread(meta, False)  # no page script to do it
        refresh_status()
    browser = os.environ.get("CLAUDE_REPORTS_BROWSER") or (
        "google-chrome-stable" if shutil.which("google-chrome-stable") else "xdg-open")
    subprocess.Popen([*shlex.split(browser), url], stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if focus := os.environ.get("CLAUDE_REPORTS_FOCUS"):
        cmd = focus.replace("{title}", shlex.quote(page_title(meta)))
        subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def open_pane(pane):
    """Open the report of the session that claude-tasks recorded for a tmux pane."""
    if not re.fullmatch(r"%?\d+", pane or ""):
        sys.exit(f"claude-reports: bad pane {pane!r}")
    try:
        fields = (TASKS / pane.lstrip("%")).read_text().rstrip("\n").split("\t")
    except OSError:
        fields = []
    sid = fields[3] if len(fields) > 3 else ""
    if not sid:
        msg = "claude-reports: no Claude session in this pane"
    elif find(sid) is None:
        msg = "claude-reports: no report yet (one appears when Claude finishes a reply)"
    else:
        return open_report(sid)
    tmux("display-message", msg)
    sys.exit(msg)


