RENDER_JS = r"""
const J = (id) => { const e = document.getElementById(id); return e ? JSON.parse(e.textContent) : null; };
const META = J('meta'), PAGE = J('page'), SRC = J('src'), TURNS = J('turns') || [], ICONS = J('icons');
const AVATARS = J('avatars') || {};
function avatar(kind, iconName) {  // your picture from the config folder, else an icon
  const a = el('div', 'avatar ' + kind);
  if (AVATARS[kind]) {
    const img = el('img');
    img.src = AVATARS[kind];
    img.alt = '';
    a.classList.add('pic');
    a.append(img);
  } else a.append(icon(iconName));
  return a;
}
const md = window.markdownit({ html: false, linkify: true, highlight: (str, lang) => {
  if (window.hljs && lang && hljs.getLanguage(lang)) {
    try { return hljs.highlight(str, { language: lang }).value; } catch (_) {}
  }
  return '';
}});
function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text != null) e.textContent = text;
  return e;
}
function icon(name) {  // the markup is ours (ICONS), never transcript text
  const t = document.createElement('template');
  t.innerHTML = '<svg class="i" viewBox="0 0 16 16" aria-hidden="true">' + ICONS[name] + '</svg>';
  return t.content.firstChild;
}
function ago(t) {
  const s = Math.max(0, Date.now() / 1000 - t);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.round(s / 60) + ' min ago';
  if (s < 86400) return Math.round(s / 3600) + ' h ago';
  return Math.round(s / 86400) + ' d ago';
}
const oneLine = (t) => t.replace(/\s+/g, ' ').trim();
// Markdown from the transcript, through markdown-it with html: false: shown, never run.
function markdown(text, cls) {
  const d = el('div', 'markdown-body' + (cls ? ' ' + cls : ''));
  d.innerHTML = md.render(text);
  for (const pre of d.querySelectorAll('pre')) {
    const b = el('button', 'copy');
    b.append(icon('copy'), 'Copy');
    b.onclick = async () => {
      try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent);
            b.lastChild.textContent = 'Copied'; } catch (_) { b.lastChild.textContent = 'Select it'; }
      setTimeout(() => { b.lastChild.textContent = 'Copy'; }, 1500);
    };
    pre.append(b);
  }
  return d;
}
// A prompt as plain text, collapsed to its first line when there is more.
function bubble(text) {
  text = text.trim();
  const first = oneLine(text.split('\n')[0]);
  if (first === text && first.length <= 160) return el('div', 'bubble', text);
  const d = el('details', 'bubble');
  const s = el('summary');
  s.append(el('span', 'first', first), el('span', 'more', text.length.toLocaleString() + ' characters · expand'));
  d.append(s, el('div', 'full', text));
  return d;
}
// "Message from session X:" marks a prompt another Claude session sent.
function who(text) {
  const m = /^Message from session (.+?):\n\n/.exec(text);
  return m ? { name: m[1], peer: true, text: text.slice(m[0].length) } : { name: 'You', peer: false, text };
}
// The prompt, then what arrived while Claude worked on it (queued by you or sent by a session).
function prompt(text) {
  const [main, ...later] = text.split('\n\n↳ ');
  const w = who(main);
  const m = el('div', 'msg');
  const av = w.peer ? avatar('peer', 'bot') : avatar('you', 'user');
  const head = el('div', 'msg-head');
  head.append(el('b', '', w.name), w.peer ? 'sent a message' : 'asked');
  const body = el('div', 'msg-body');
  body.append(bubble(w.text));
  if (later.length) {
    const f = el('div', 'followups');
    for (const part of later) {
      const i = part.indexOf(':\n\n');
      const box = el('div');
      box.append(el('div', 'followup-head', i > 0 ? '↳ ' + part.slice(0, i) : '↳'),
                 bubble(i > 0 ? part.slice(i + 3) : part));
      f.append(box);
    }
    body.append(f);
  }
  m.append(av, head, body);
  return m;
}
function reply(text, saidOnly) {
  const m = el('div', 'msg');
  const av = avatar('claude', 'spark');
  const head = el('div', 'msg-head');
  head.append(el('b', '', 'Claude'), 'replied');
  const body = el('div', 'msg-body');
  if (saidOnly) body.append(el('p', 'said-only', 'Last thing Claude wrote before the session ended:'));
  body.append(text ? markdown(text) : el('p', 'said-only', '(no reply)'));
  m.append(av, head, body);
  return m;
}
function prop(iconName, text, cls, title) {
  const p = el('span', 'prop' + (cls ? ' ' + cls : ''));
  if (iconName) p.append(icon(iconName));
  p.append(text);
  if (title) p.title = title;
  return p;
}
document.getElementById('title').textContent = META.title;

// Live state (from the server's /api/state): status badge and the "working" card.
let LIVE = null;
function setLive(s) {
  LIVE = s;
  const props = document.getElementById('props');
  props.replaceChildren();
  if (s) {
    const st = s.busy === 'waiting' ? ['waiting', 'Waiting for you']
             : s.busy === 'running' ? ['running', 'Working']
             : s.open ? ['open', 'Open'] : ['', 'Closed'];
    const p = el('span', 'prop status ' + st[0]);
    p.append(el('i', 'dot'), el('span', '', st[1]));
    props.append(p);
    if (s.unread) props.append(prop(null, 'Unread', 'unread'));
  }
  const target = (s && s.target) || META.tmux;
  if (target) props.append(prop('term', target, 'mono', s && s.open ? 'tmux pane' : 'tmux pane (last known)'));
  if (META.folder) props.append(prop('folder', META.folder, 'mono'));
  if (META.branch) props.append(prop('branch', META.branch, 'mono'));
  props.append(prop('clock', ago(META.ended), '', 'Finished ' + new Date(META.ended * 1000).toLocaleString()));
  props.append(prop('turns', 'Turn ' + META.turn, '', META.session ? 'Session running for ' + META.session : ''));
  const id = el('button', 'prop mono', null);
  id.append(icon('hash'), META.id.slice(0, 8));
  id.title = 'Copy the session id ' + META.id;
  id.onclick = async () => { try { await navigator.clipboard.writeText(META.id); id.lastChild.textContent = 'copied'; } catch (_) {}
                             setTimeout(() => { id.lastChild.textContent = META.id.slice(0, 8); }, 1500); };
  props.append(id);

  const busy = document.getElementById('busy');
  busy.classList.toggle('on', !!(s && s.busy));
  if (s && s.busy) {
    busy.className = 'card on ' + s.busy;
    const since = s.since ? ' · since ' + new Date(s.since * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
    const head = document.getElementById('busy-head');
    head.replaceChildren(s.busy === 'waiting' ? 'Waiting for you in the pane (permission prompt or question)'
                         : s.prompt ? 'Working on a new message' : 'Working again', el('span', 'since', since));
    document.getElementById('busy-prompt').textContent = s.prompt ? oneLine(s.prompt) : '';
    document.getElementById('busy-prompt').title = s.prompt || '';
  }
}
setLive(null);

const notes = document.getElementById('notes');
function note(text) {
  const c = el('div', 'card note');
  c.append(el('span', 'dot'), el('b', '', text));
  notes.append(c);
}
if (META.unfinished) note('Unfinished: the session ended before Claude finished its reply.');
if (META.background) note('Still working: ' + META.background + ' background task' + (META.background > 1 ? 's' : '') +
                          ' running; Claude may continue and update this report.');

