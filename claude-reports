ID = re.compile(r"^[A-Za-z0-9-]+$")

# ---------------------------------------------------------------- reading the transcript
# Same cleaning rules as claude-sessions: only what you and Claude wrote counts.

SYSTEM_REMINDER = re.compile(r"<system-reminder>.*?</system-reminder>", re.S)
PASTE_TAG = re.compile(r"</?pasted_content[^>]*>")
COMMAND = re.compile(r"<command-name>(.*?)</command-name>.*?<command-args>(.*?)</command-args>", re.S)
BASH_INPUT = re.compile(r"<bash-input>(.*?)</bash-input>", re.S)
NOISE = re.compile(
    r"\s*(<(local-command-\w+|bash-std\w+|task-notification|command-message)\b"
    r"|\[Request interrupted by user)"
)
INTERRUPTED = re.compile(r"\s*\[Request interrupted by user")
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
EDIT_TOOLS = {"Write", "Edit", "MultiEdit", "NotebookEdit"}


def text_of(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(
            b.get("text", "") for b in content if isinstance(b, dict) and b.get("type") == "text"
        )
    return ""


def clean_prompt(text):
    """(prompt text, is a slash command); ("", _) for things that are not a prompt."""
    text = SYSTEM_REMINDER.sub("", text)
    if m := COMMAND.search(text):
        name, args = m.group(1).strip(), m.group(2).strip()
        return (f"{name} {args}" if args else ""), True
    if m := BASH_INPUT.search(text):
        return "! " + m.group(1).strip(), True
    if NOISE.match(text):
        return "", False
    return PASTE_TAG.sub("", text).strip(), False


def parse(path):
    """What a report needs from a transcript: metadata, prompts, files, and the final reply."""
    s = {"cwd": None, "branch": None, "started": None, "last": None, "entrypoint": None,
         "titles": {}, "prompts": [], "replies": [], "files": {}, "turn_files": {}, "final": [],
         "said": "",
         "interrupted": False,
         "pending_tool": False}
    records = []
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            try:
                r = json.loads(line)
            except ValueError:
                continue  # e.g. a half-written last line
            if isinstance(r, dict):
                records.append(r)
    active = active_branch(records)
    for r in records:
        kind = r.get("type")
        if kind == "custom-title" and r.get("customTitle"):
            s["titles"]["custom"] = r["customTitle"]
        elif kind == "ai-title" and r.get("aiTitle"):
            s["titles"]["ai"] = r["aiTitle"]
        elif kind == "summary" and r.get("summary"):
            s["titles"].setdefault("ai", r["summary"])
        elif kind == "attachment":
            queued(s, r, active)
        if kind not in ("user", "assistant") or not isinstance(r.get("message"), dict):
            continue
        if any(r.get(k) for k in ("isSidechain", "isMeta", "isCompactSummary",
                                  "isVisibleInTranscriptOnly", "isApiErrorMessage")):
            continue
        if active and r.get("uuid") and r["uuid"] not in active:
            continue  # on a branch that a rewind abandoned
        s["cwd"] = r.get("cwd") or s["cwd"]
        s["branch"] = r.get("gitBranch") or s["branch"]
        s["started"] = s["started"] or r.get("timestamp")
        s["last"] = max(s["last"] or "", r.get("timestamp") or "") or None
        s["entrypoint"] = s["entrypoint"] or r.get("entrypoint")
        content = r["message"].get("content")
        if kind == "user":
            origin = r.get("origin")
            if isinstance(origin, dict) and origin.get("kind") not in (None, "human"):
                continue
            if isinstance(content, list) and any(
                    isinstance(b, dict) and b.get("type") == "tool_result" for b in content):
                s["pending_tool"] = False
                continue
            raw = CONTROL.sub("", text_of(content))
            if INTERRUPTED.match(raw):
                s["interrupted"] = True
                continue
            text, is_command = clean_prompt(raw)
            if text and not is_command:
                if s["prompts"]:  # close the previous turn: keep what Claude answered
                    s["replies"].append("\n\n".join(s["final"]) or s["said"])
                s["prompts"].append(text)
                s["final"], s["said"], s["interrupted"], s["pending_tool"] = [], "", False, False
                s["turn_files"] = {}
            continue
        # assistant: the final reply is the text after the last tool call of the last turn
        if not isinstance(content, list):
            content = [{"type": "text", "text": content}] if isinstance(content, str) else []
        for b in content:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "tool_use":
                s["final"], s["pending_tool"] = [], True
                if b.get("name") in EDIT_TOOLS:
                    inp = b.get("input") or {}
                    p = inp.get("file_path") or inp.get("notebook_path")
                    if isinstance(p, str) and p:
                        s["files"][p] = s["turn_files"][p] = None
            elif b.get("type") == "text":
                t = CONTROL.sub("", b.get("text") or "").strip()
                if t and t != "(no content)" and s["prompts"]:
                    s["final"].append(t)
                    s["said"] = t  # last text of the turn, even if tool calls followed
    return s


QUEUED = "\n\n↳ Sent while Claude was working:\n\n"


def queued(s, r, active):
    """A message you typed while Claude was busy, which it read mid-turn.

    Claude Code doesn't record it as a user message but as an attachment that it injects
    into the running turn. It belongs to the current prompt: the turn's reply answers both.
    """
    a = r.get("attachment")
    if not (isinstance(a, dict) and a.get("type") == "queued_command"
            and a.get("commandMode") == "prompt"
            and isinstance(a.get("origin"), dict) and a["origin"].get("kind") == "human"):
        return  # also task notifications and messages from other sessions
    if r.get("isSidechain") or (active and r.get("uuid") and r["uuid"] not in active):
        return
    text, is_command = clean_prompt(CONTROL.sub("", text_of(a.get("prompt"))))
    if not text or is_command:
        return
    if s["prompts"]:
        s["prompts"][-1] += QUEUED + text
    else:
        s["prompts"].append(text)


def active_branch(records):
    """uuids of the conversation as it stands now.

    A rewind doesn't delete anything: the transcript keeps the rewound messages, and new ones
    branch off an earlier message (each record names its parent in parentUuid). The newest
    message is the tip of the current branch; walking its parents back to the start gives
    the messages that still count. /compact starts a new chain whose first record points
    back through logicalParentUuid. Empty if the records carry no uuids (nothing to filter).
    """
    by_id = {r["uuid"]: r for r in records if isinstance(r.get("uuid"), str)}
    tip = next((r["uuid"] for r in reversed(records)
                if r.get("type") in ("user", "assistant") and not r.get("isSidechain")
                and isinstance(r.get("uuid"), str)), None)
    active, node = set(), tip
    while node and node not in active:
        active.add(node)
        r = by_id.get(node)
        if r is None:
            break
        node = r.get("parentUuid") or r.get("logicalParentUuid")
    return active


# ---------------------------------------------------------------- writing a report

def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def tmux_info(pane):
    """{"target": "session:window.pane", "session", "pane_title", "watched"} or {}.

    watched: the pane is the active one of its window, the window is the active one of its
    session, and a terminal showing that session has focus (tmux focus-events). Without focus
    events no client is ever "focused", so nothing counts as watched and every reply is unread.
    """
    if not pane:
        return {}
    out = tmux("display", "-p", "-t", pane,
               "#S\x1f#I\x1f#P\x1f#{pane_active}#{window_active}\x1f#{pane_title}").rstrip("\n")
    parts = out.split("\x1f", 4)
    if len(parts) != 5:
        return {}
    sess, win, idx, active, title = parts
    if not sess or not win:
        return {}  # the pane is gone (e.g. tmux is tearing it down)
    focused = any(
        line.split("\t")[0] == sess and "focused" in line.split("\t")[-1].split(",")
        for line in tmux("list-clients", "-F", "#{client_session}\t#{client_flags}").splitlines())
    # Claude Code sets the pane title to its summary of the session, e.g. "✳ Fix login bug".
    m = re.match(r"^[^\w\s]+\s+(.*)$", title)
    title = m.group(1) if m else title
    if title in ("", "Claude Code", os.uname().nodename):
        title = ""
    return {"target": f"{sess}:{win}.{idx}", "session": sess, "pane_title": title, "pane": pane,
            "watched": active == "11" and focused}


def local(ts):
    """ISO timestamp (UTC, from the transcript) → local datetime, or None."""
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


def home(path):
    h = str(Path.home())
    return "~" + path[len(h):] if path and (path == h or path.startswith(h + "/")) else path


def duration(a, b):
    if not a or not b:
        return ""
    m = max(0, round((b - a).total_seconds() / 60))
    if m == 0:
        return "<1 min"
    return f"{m} min" if m < 60 else f"{m // 60} h {m % 60:02d} min"


def clip(text, n):
    return text if len(text) <= n else text[:n].rstrip() + " …"


def quote(text):
    return "\n".join("> " + line if line.strip() else ">" for line in text.splitlines())


def code(text):
    """Inline code span that survives backticks in the text."""
    ticks = "`" * (max((len(m) for m in re.findall(r"`+", text)), default=0) + 1)
    pad = " " if text.startswith("`") or text.endswith("`") else ""
    return f"{ticks}{pad}{text}{pad}{ticks}"


def build(sid, s, info, ended, last_message=None, background=0):
    """(metadata dict, markdown) for a session's latest reply.

    last_message is the Stop hook's last_assistant_message: Claude's final reply, which the
    transcript may not hold yet when the hook runs.
    """
    title, title_kind = None, None
    for kind, value in (("custom", s["titles"].get("custom")), ("ai", s["titles"].get("ai")),
                        ("pane", info.get("pane_title")),
                        ("prompt", s["prompts"][0].strip().splitlines()[0] if s["prompts"] else "")):
        if value and value.strip():
            title, title_kind = clip(value.strip(), 100), kind
            break
    final = "\n\n".join(s["final"])
    if last_message and last_message.strip():
        lm = last_message.strip()
        # The transcript's version can hold more (several text blocks after the last tool
        # call); use it when it ends with the same message.
        if not (s["final"] and s["final"][-1].strip() == lm):
            final = lm
        unfinished = False
    else:
        unfinished = s["interrupted"] or s["pending_tool"] or not final
    cwd = s["cwd"] or ""
    start = local(s["started"])
    end = datetime.fromtimestamp(ended).astimezone()

    def rel(p):
        return os.path.relpath(p, cwd) if cwd and p.startswith(cwd.rstrip("/") + "/") else home(p)

    files = [rel(p) for p in s["turn_files"]]
    meta = {
        "id": sid, "title": title or "(untitled)", "title_kind": title_kind,
        "tmux": info.get("target", ""), "tmux_session": info.get("session", ""),
        "pane": info.get("pane", ""),
        "cwd": cwd, "branch": s["branch"] or "", "started": s["started"],
        "ended": ended, "prompts": len(s["prompts"]), "files": files,
        "unfinished": unfinished, "background": background,
        "unread": not info.get("watched", False),
    }

    rows = []
    if meta["tmux"]:
        rows.append(("tmux", code(meta["tmux"])))
    rows.append(("Folder", code(home(cwd) or "?")))
    if meta["branch"]:
        rows.append(("Branch", code(meta["branch"])))
    rows.append(("Finished", f"{end:%Y-%m-%d %H:%M}"))
    if start:
        rows.append(("Session", f"started {start:%Y-%m-%d %H:%M} ({duration(start, end)}), "
                                f"prompt {len(s['prompts'])}"))
    rows.append(("Id", code(sid)))

    md = [f"# {title or '(untitled)'}", ""]
    if unfinished:
        md += ["> **Unfinished:** the session ended before Claude finished its reply.", ""]
    if background:
        md += [f"> **Still working:** {background} background task{'s' if background > 1 else ''} "
               "running; Claude may continue and update this report.", ""]
    md += ["| | |", "|---|---|"]
    md += [f"| **{k}** | {v.replace('|', chr(92) + '|')} |" for k, v in rows] + [""]
    if s["prompts"]:
        md += ["## Asked", "", quote(clip(s["prompts"][-1], 3000)), ""]
    if final:
        md += ["## Report", "", final, ""]
    elif s["said"]:
        md += ["## Report", "", "*Last thing Claude wrote before the session ended:*", "",
               s["said"], ""]
    else:
        md += ["## Report", "", "*(no reply)*", ""]
    if files:
        md += ["## Files changed", ""] + [f"- {code(f)}" for f in files] + [""]
    turns = earlier_turns(s)
    if turns:
        # Plain markdown for the terminal preview; the browser page shows these collapsed.
        md += [EARLIER, ""]
        for t in turns:
            head = t["prompt"].split(QUEUED)[0]
            md += [f"### {t['n']}. {clip(' '.join(head.split()), 150)}", "",
                   clip(t["reply"], 1500) if t["reply"] else "*(no reply)*", ""]
        hidden = len(s["prompts"]) - 1 - len(turns)
        if hidden:
            md += [f"*{hidden} older prompt{'s' if hidden > 1 else ''} not shown*", ""]
    return meta, "\n".join(md)


EARLIER = "## Earlier in this session"
MAX_TURNS = 20


def earlier_turns(s):
    """The turns before the latest one, newest first: [{"n", "prompt", "reply"}]."""
    turns = [{"n": i + 1, "prompt": p, "reply": r}
             for i, (p, r) in enumerate(zip(s["prompts"][:-1], s["replies"]))]
    return turns[::-1][:MAX_TURNS]


def write_atomic(path, text):
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(path)


def prune():
    cutoff = time.time() - KEEP_DAYS * 86400
    for f in STATE.glob("*.json"):
        if "." in f.stem:
            continue  # <id>.turns.json goes with its report
        meta = find(f.stem)
        if meta is None or meta.get("ended", 0) < cutoff:
            remove(f.stem)
    for f in STATE.glob("*.turns.json"):  # orphans
        if not (STATE / f"{f.name[:-len('.turns.json')]}.json").exists():
            f.unlink(missing_ok=True)


def remove(sid):
    for p in (STATE / f"{sid}.json", STATE / f"{sid}.md", STATE / f"{sid}.turns.json",
              STATE / "html" / f"{sid}.html"):
        p.unlink(missing_ok=True)


def refresh_status():
    for client in tmux("list-clients", "-F", "#{client_name}").split():
        tmux("refresh-client", "-S", "-t", client)


def hook():
    try:
        data = json.load(sys.stdin)
    except ValueError:
        return
    if data.get("hook_event_name") not in (None, "Stop"):
        return  # e.g. an old SessionEnd entry: the last Stop already wrote the report
    sid, transcript = data.get("session_id") or "", data.get("transcript_path") or ""
    if not ID.match(sid) or not os.path.isfile(transcript):
        return
    s = parse(transcript)
    pane = os.environ.get("TMUX_PANE", "")
    # `claude -p` and SDK runs from scripts would flood the list; inside tmux they are yours.
    if not s["prompts"] or ((s["entrypoint"] or "").startswith("sdk") and not pane):
        return
    STATE.mkdir(parents=True, exist_ok=True)
    bg = data.get("background_tasks")
    meta, md = build(sid, s, tmux_info(pane), time.time(), data.get("last_assistant_message"),
                     len(bg) if isinstance(bg, list) else 0)
    write_atomic(STATE / f"{sid}.md", md)
    write_atomic(STATE / f"{sid}.turns.json", json.dumps(earlier_turns(s), ensure_ascii=False))
    write_atomic(STATE / f"{sid}.json", json.dumps(meta, ensure_ascii=False, indent=1))
    (STATE / "html" / f"{sid}.html").unlink(missing_ok=True)
    prune()
    refresh_status()


# ---------------------------------------------------------------- reading reports

def find(sid):
    """A report's metadata, or None."""
    if not ID.match(sid or ""):
        return None
    try:
        m = json.loads((STATE / f"{sid}.json").read_text())
    except (OSError, ValueError):
        return None
    return m if isinstance(m, dict) and m.get("id") == sid else None


def load(sid):
    if not ID.match(sid or ""):
        sys.exit(f"claude-reports: bad id {sid!r}")
    if (m := find(sid)) is None:
        sys.exit(f"claude-reports: no report {sid}")
    return m


def reports():
    out = [m for f in STATE.glob("*.json") if "." not in f.stem and (m := find(f.stem))]
    out.sort(key=lambda m: (not m.get("unread"), -m.get("ended", 0)))
    return out


def set_unread(meta, unread):
    if meta.get("unread") != unread:
        meta["unread"] = unread
        write_atomic(STATE / f"{meta['id']}.json", json.dumps(meta, ensure_ascii=False, indent=1))


def ago(epoch):
    s = int(time.time() - epoch)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def fit(text, n):
    text = " ".join(str(text).split())
    return (text if len(text) <= n else text[:n - 1] + "…").ljust(n)


# ---------------------------------------------------------------- open sessions
# Which sessions are open right now, from tmux-claude-tasks' per-pane state files:
# "status<TAB>epoch<TAB>cwd<TAB>session id<TAB>pid start", where "pid start" identifies the
# process hosting the session (start = /proc/PID/stat field 22, fixed for a process's life).

def started(pids):
    out = set()
    for pid in pids:
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            continue
        out.add(f"{pid} {stat[stat.rindex(')') + 2:].split()[19]}")
    return out


def live_sessions():
    """{session id: (pane id, "session:window.pane")} for sessions open in a tmux pane."""
    try:
        files = list(TASKS.iterdir())
    except OSError:
        return {}
    panes = {}
    for line in tmux("list-panes", "-a", "-F", "#{pane_id}\t#S:#I.#P").splitlines():
        if "\t" in line:
            pane, target = line.split("\t", 1)
            panes[pane] = target
    entries = []
    for f in files:
        try:
            fields = f.read_text().rstrip("\n").split("\t")
        except OSError:
            continue
        pane = "%" + f.name
        if len(fields) >= 4 and fields[3] and pane in panes:
            entries.append((fields[3], pane, fields[4] if len(fields) > 4 else ""))
    alive = started({p for _, _, proc in entries if (p := proc.split(" ", 1)[0]).isdigit()})
    alive_pids = {a.split(" ", 1)[0] for a in alive}

    def running(proc):
        if not proc or proc in alive:
            return True  # entries from before claude-tasks recorded the process stay visible
        # recorded by an older claude-tasks as "pid weekday month day time year": pid only
        return proc.count(" ") > 1 and proc.split(" ", 1)[0] in alive_pids

    return {sid: (pane, panes[pane]) for sid, pane, proc in entries if running(proc)}


def list_reports():
    live = live_sessions()
    for m in reports():
        icon, color = ("●", "32") if m.get("unread") else ("○", "90")
        if m.get("unfinished"):
            icon, color = ("!", "31") if m.get("unread") else ("!", "90")
        folder = os.path.basename((m.get("cwd") or "").rstrip("/")) or "?"
        where = f"\x1b[36m▶ {fit(live[m['id']][1], 18)}\x1b[0m" if m["id"] in live \
            else f"\x1b[90m  {fit('closed', 18)}\x1b[0m"
        print(f"{m['id']}\t\x1b[{color}m{icon}\x1b[0m {fit(m.get('title', ''), 38)}  {where} "
              f"\x1b[90m{fit(folder, 14)} {ago(m.get('ended', 0)):>4}\x1b[0m")


def show(sid):
    load(sid)
    sys.stdout.write((STATE / f"{sid}.md").read_text(encoding="utf-8"))


# ---------------------------------------------------------------- tmux, Konsole, KWin

def tmux_env():
    """Environment for programs that expect to run inside tmux (claude-sessions open)."""
    env = dict(os.environ)
    if not env.get("TMUX"):
        sock = tmux("display", "-p", "#{socket_path}").strip()
        if sock:
            env["TMUX"] = f"{sock},0,0"
    if not env.get("CLAUDE_SESSIONS_RESUME"):
        # The service doesn't see your shell's variables; tmux options it can read.
        cmd = tmux("show", "-gqv", "@claude-tasks-resume-command").strip()
        if cmd:
            env["CLAUDE_SESSIONS_RESUME"] = cmd
    return env


def latest_client():
    """(client name, client pid) of the tmux client used most recently, or None."""
    best = None
    for line in tmux("list-clients", "-F", "#{client_activity}\t#{client_name}\t#{client_pid}").splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[0].isdigit() and (best is None or int(parts[0]) > best[0]):
            best = (int(parts[0]), parts[1], parts[2])
    return best and (best[1], best[2])


def ancestors(pid):
    """[pid, parent, grandparent, ...] up to (not including) init."""
    chain = []
    pid = int(pid)
    while pid > 1 and len(chain) < 64:
        chain.append(pid)
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        pid = int(stat[stat.rindex(")") + 2:].split()[1])
    return chain


def comm(pid):
    try:
        return Path(f"/proc/{pid}/comm").read_text().strip()
    except OSError:
        return ""


def qdbus(*args):
    try:
        return subprocess.run(["qdbus6", *map(str, args)], capture_output=True, text=True,
                              timeout=3).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def select_konsole_tab(chain):
    """In the Konsole that hosts this process chain, make the tab running it current."""
    for i, pid in enumerate(chain):
        if comm(pid) == "konsole" and i > 0:
            svc, shell = f"org.kde.konsole-{pid}", chain[i - 1]
            for obj in qdbus(svc).splitlines():
                if re.fullmatch(r"/Windows/\d+", obj):
                    for sess in qdbus(svc, obj, "org.kde.konsole.Window.sessionList").split():
                        if qdbus(svc, f"/Sessions/{sess}", "org.kde.konsole.Session.processId") == str(shell):
                            qdbus(svc, obj, "org.kde.konsole.Window.setCurrentSession", sess)
                            return


KWIN_RAISE = """
const pids = %s;
let best = null;
for (const w of workspace.stackingOrder) {
  if (w.normalWindow && pids.includes(w.pid)) best = w;  // last match = topmost
}
if (best) {
  if (best.minimized) best.minimized = false;
  if (!best.onAllDesktops && best.desktops.length && !best.desktops.includes(workspace.currentDesktop))
    workspace.currentDesktop = best.desktops[0];
  workspace.activeWindow = best;
}
"""


def raise_window(chain):
    """Activate the window owned by the nearest process in chain, via a one-off KWin script.
    Scripts are trusted by KWin, so this works whatever the focus-stealing setting is."""
    if not chain or not shutil.which("qdbus6"):
        return False
    script = STATE / "kwin-raise.js"
    write_atomic(script, KWIN_RAISE % json.dumps(chain))
    name = f"claude-reports-{os.getpid()}-{time.monotonic_ns()}"
    sid = qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.loadScript", script, name)
    if not sid.isdigit():
        return False
    qdbus("org.kde.KWin", f"/Scripting/Script{sid}", "org.kde.kwin.Script.run")
    time.sleep(0.2)
    qdbus("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting.unloadScript", name)
    return True


def focus_pane(pane):
    """Show the pane in the most recently used tmux client and raise that terminal."""
    client = latest_client()
    if not client:
        return False, "no terminal is attached to tmux"
    name, pid = client
    tmux("switch-client", "-c", name, "-t", pane, ";", "select-window", "-t", pane, ";",
         "select-pane", "-t", pane)
    chain = ancestors(pid)
    select_konsole_tab(chain)
    raise_window(chain)
    return True, "focused"


# ---------------------------------------------------------------- actions

def resume(sid):
    """Go to the session: jump to its pane if open, else resume it in a new tmux window."""
    meta = load(sid)
    set_unread(meta, False)
    env = tmux_env()
    # claude-sessions jumps to the pane if the session is still open, else resumes it.
    if shutil.which("claude-sessions"):
        r = subprocess.run(["claude-sessions", "open", sid], capture_output=True, text=True, env=env)
        if r.returncode == 0:
            return
    cwd = meta.get("cwd") or ""
    if not os.path.isdir(cwd):
        msg = f"claude-reports: project folder {cwd} no longer exists"
        tmux("display-message", msg)
        sys.exit(msg)
    cmd = RESUME.replace("{id}", shlex.quote(sid))
    if env.get("TMUX"):
        # Typed into a shell, so the window stays usable after claude exits.
        pane = tmux("new-window", "-P", "-F", "#{pane_id}", "-c", cwd).strip()
        tmux("send-keys", "-t", pane, "-l", cmd)
        tmux("send-keys", "-t", pane, "Enter")
    else:
        os.chdir(cwd)
        shell = os.environ.get("SHELL") or "/bin/sh"
        os.execvp(shell, [shell, "-c", cmd])


def state_of(meta, live=None):
    live = live_sessions() if live is None else live
    pane = live.get(meta["id"])
    return {"id": meta["id"], "unread": bool(meta.get("unread")), "open": bool(pane),
            "target": pane[1] if pane else "", "version": meta.get("ended", 0)}


def act(action, sid):
    """Run a button's action. (HTTP status, message)."""
    meta = find(sid)
    if meta is None:
        return 404, "no such report"
    if action in ("read", "unread"):
        set_unread(meta, action == "unread")
        refresh_status()
        return 200, f"marked {action}"
    live = live_sessions()
    if action == "focus":
        set_unread(meta, False)
        refresh_status()
        if sid in live:
            ok, msg = focus_pane(live[sid][0])
            return (200 if ok else 409), msg
        try:
            resume(sid)
        except SystemExit as e:
            return 409, str(e)
        client = latest_client()
        if client:
            chain = ancestors(client[1])
            select_konsole_tab(chain)
            raise_window(chain)
        return 200, "resumed in a new tmux window"
    if action == "kill":
        # Only a pane that still runs this very session: claude-tasks recorded the session id
        # for the pane and the process hosting it is still alive. A stale report must never
        # kill whatever runs in that pane now.
        if sid not in live:
            return 409, "the session isn't open in tmux anymore"
        pane, target = live[sid]
        tmux("kill-pane", "-t", pane)
        set_unread(meta, False)
        refresh_status()
        return 200, f"killed {target}"
    return 404, "unknown action"


